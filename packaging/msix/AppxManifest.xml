<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store (MSIX) package for Emoji Anywhere. Identity values come from Partner Center (product identity page).
     The Store signs the package, so no certificate is needed. Built by packaging/build-msix.ps1. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="BuiltByShakeel.EmojiAnywhere"
            Publisher="CN=C231B4AC-0BD6-4D80-A5CE-4EC29BBC303F"
            Version="__VERSION__"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Emoji Anywhere</DisplayName>
    <PublisherDisplayName>Built By Shakeel</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
    <Description>Discord style emoji autocomplete for Windows. Type :fire: and get 🔥.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="EmojiAnywhere" Executable="EmojiAnywhere.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Emoji Anywhere"
                          Description="Type :fire: and get 🔥 in the apps you type in."
                          BackgroundColor="transparent"
                          Square150x150Logo="Images\Square150x150Logo.png"
                          Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Starts at sign in after the first launch. People can turn it off in Settings, Apps, Startup. -->
        <desktop:Extension Category="windows.startupTask" Executable="EmojiAnywhere.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="EmojiAnywhereStartup" Enabled="true" DisplayName="Emoji Anywhere" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
