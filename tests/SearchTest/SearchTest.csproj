<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the emoji list and search. No UI, no keyboard. Runs in CI on every push. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\EmojiAnywhere\Core\EmojiIndex.cs" />
    <Compile Include="..\..\src\EmojiAnywhere\Core\Storage.cs" />
    <EmbeddedResource Include="..\..\src\EmojiAnywhere\Data\*.json" />
  </ItemGroup>
</Project>
