<Project Sdk="Microsoft.NET.Sdk">
  <!-- Clicks every control in the tray panel through accessibility. No real keyboard or mouse input. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\EmojiAnywhere\EmojiAnywhere.csproj" />
  </ItemGroup>
</Project>
