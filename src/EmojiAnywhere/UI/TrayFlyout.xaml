<Window x:Class="EmojiAnywhere.UI.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="364"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource Fly.Text}">

    <Window.Resources>
        <!-- Colors are replaced from code to follow light or dark mode -->
        <SolidColorBrush x:Key="Fly.Background" Color="#F7F8FA" />
        <SolidColorBrush x:Key="Fly.Card" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Fly.Border" Color="#1A000000" />
        <SolidColorBrush x:Key="Fly.Text" Color="#1B1D22" />
        <SolidColorBrush x:Key="Fly.Muted" Color="#646a76" />
        <SolidColorBrush x:Key="Fly.Hover" Color="#0D000000" />
        <SolidColorBrush x:Key="Fly.Track" Color="#D3D6DD" />
        <SolidColorBrush x:Key="Fly.Accent" Color="#D6336C" />
        <SolidColorBrush x:Key="Fly.OnAccent" Color="#FFFFFF" />
        <FontFamily x:Key="Fly.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- On/off switch -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="40" Height="22" Background="Transparent">
                            <Border CornerRadius="11" Background="{DynamicResource Fly.Track}" />
                            <!-- The accent fill fades in over the grey track, so the color change is smooth -->
                            <Border x:Name="Fill" CornerRadius="11" Background="{DynamicResource Fly.Accent}" Opacity="0" />
                            <Border x:Name="Focus" CornerRadius="13" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Fly.Text}" Visibility="Collapsed" />
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource Fly.Card}" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="Move" X="0" /></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Final state is set here, so the switch opens in the right position.
                                 The slide on click is played from code (TrayFlyout.AnimateSwitch). -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Fly.OnAccent}" />
                                <Setter TargetName="Thumb" Property="Margin" Value="22,0,0,0" />
                                <Setter TargetName="Fill" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One option in a row of choices -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Fly.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="6" Padding="0,6" Margin="2,0" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Fly.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Fly.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Fly.OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Fly.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiet text button -->
        <Style x:Key="Plain" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Fly.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Padding="10,6" Background="Transparent" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Fly.Hover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Fly.Text}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- App chip: name plus a remove or add glyph -->
        <Style x:Key="Chip" TargetType="Button" BasedOn="{StaticResource Plain}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="999" Padding="10,4,8,4" Background="{DynamicResource Fly.Hover}" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Fly.Border}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Fly.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Fly.Muted}" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the shadow -->
    <Border x:Name="Root" Margin="14" CornerRadius="12" Background="{DynamicResource Fly.Background}"
            BorderBrush="{DynamicResource Fly.Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.25" />
        </Border.Effect>
        <Border.RenderTransform><TranslateTransform x:Name="Slide" Y="0" /></Border.RenderTransform>

        <StackPanel>
            <!-- Header: who, status, master switch -->
            <Grid Margin="16,16,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="AppIcon" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Emoji Anywhere" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="Status" Foreground="{DynamicResource Fly.Muted}" />
                </StackPanel>
                <ToggleButton x:Name="EnabledSwitch" Grid.Column="2" Style="{StaticResource Switch}" VerticalAlignment="Center"
                              AutomationProperties.Name="Emoji Anywhere on or off" />
            </Grid>

            <!-- Settings card -->
            <Border Margin="8,0,8,8" Padding="12,12,12,10" CornerRadius="8" Background="{DynamicResource Fly.Card}"
                    BorderBrush="{DynamicResource Fly.Border}" BorderThickness="1">
                <StackPanel>
                    <Button x:Name="PauseButton" Style="{StaticResource Plain}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="-6,-4,-6,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE769;" FontFamily="{DynamicResource Fly.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="PauseText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="Results shown" Style="{StaticResource Label}" />
                    <UniformGrid x:Name="ResultsRow" Rows="1" Margin="0,0,0,12" />

                    <TextBlock Text="Popup size" Style="{StaticResource Label}" />
                    <UniformGrid x:Name="SizeRow" Rows="1" Margin="0,0,0,12" />

                    <Grid x:Name="StartupRow" Margin="2,2,0,2">
                        <TextBlock Text="Start with Windows" VerticalAlignment="Center" />
                        <ToggleButton x:Name="StartupSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      AutomationProperties.Name="Start with Windows" />
                    </Grid>
                    <TextBlock x:Name="StartupStoreNote" Visibility="Collapsed" TextWrapping="Wrap" Margin="2,2,0,2"
                               Foreground="{DynamicResource Fly.Muted}" FontSize="12"
                               Text="Starts with Windows. To change it, open Settings, then Apps, then Startup." />
                </StackPanel>
            </Border>

            <!-- Apps card -->
            <Border Margin="8,0,8,8" Padding="12,12,12,6" CornerRadius="8" Background="{DynamicResource Fly.Card}"
                    BorderBrush="{DynamicResource Fly.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Ignored apps" Style="{StaticResource Label}" />
                    <WrapPanel x:Name="IgnoredChips" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Label}">
                        <Run Text="Paste mode" /><Run Text="  for apps where emojis don't show up" FontSize="11" />
                    </TextBlock>
                    <WrapPanel x:Name="PasteChips" />
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Grid Margin="8,0,8,8">
                <Button x:Name="SourceButton" Style="{StaticResource Plain}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE943;" FontFamily="{DynamicResource Fly.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Source code" />
                    </StackPanel>
                </Button>
                <Button x:Name="QuitButton" Style="{StaticResource Plain}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" FontFamily="{DynamicResource Fly.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Quit" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
